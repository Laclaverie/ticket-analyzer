# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# --- Database ---
# Path to the SQLite database file.
DATABASE_URL=sqlite:///./data/ticket_analyzer.db

# --- Storage ---
# Filesystem path where receipt images will be stored.
STORAGE_PATH=./data/images

# --- API Security ---
# Static token used by trusted clients (Android app, web client).
# Leave empty to disable token validation in development.
API_TOKEN=change_me_before_exposing_to_network

# --- Worker ---
# How often the worker polls for pending jobs (seconds).
POLL_INTERVAL_SECONDS=5
