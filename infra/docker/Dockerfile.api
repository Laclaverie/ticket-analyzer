FROM python:3.12-slim

RUN pip install uv

WORKDIR /app

COPY pyproject.toml ./
COPY packages/ packages/
COPY apps/api-service/ apps/api-service/

RUN uv sync --package api-service

EXPOSE 8000

CMD ["uv", "run", "--package", "api-service", \
     "uvicorn", "api_service.main:app", \
     "--host", "0.0.0.0", "--port", "8000"]
